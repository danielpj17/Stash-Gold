# Neon Postgres connection string. Get it from the Neon dashboard after creating
# a project, then run docs/neon-setup.sql once against that database.
DATABASE_URL=

# --- Auth.js ---------------------------------------------------------------
# Signing key for session cookies and magic-link tokens.
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=

# Public origin of the deployment. Needed so magic-link callback URLs resolve
# correctly. Locally this is http://localhost:3000
AUTH_URL=http://localhost:3000

# --- Magic-link email (Gmail SMTP) -----------------------------------------
# EMAIL_SERVER_PASSWORD must be a Gmail *App Password* (16 chars, no spaces),
# which requires 2-Step Verification on the account. A normal Gmail password
# will not work. Free tier allows ~500 sends/day.
EMAIL_SERVER_HOST=smtp.gmail.com
EMAIL_SERVER_PORT=465
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM="Stash <you@gmail.com>"

# --- Optional -------------------------------------------------------------
# iCloud share link for the pre-built iOS Shortcut. When set, /settings shows an
# "Add to iPhone" button instead of manual setup instructions. The Shortcut
# prompts each user for their own token on install (an Import Question), so one
# link serves everyone. Authored by hand once — see docs/ios-shortcut-setup.md.
# NEXT_PUBLIC_ because it's read client-side, so it is inlined at BUILD time:
# changing it needs a rebuild, not just a restart. The link is public by design.
NEXT_PUBLIC_SHORTCUT_ICLOUD_URL=

# Set to "false" to omit the per-row local `date` field from /api/transactions.
# `date` used to be absent entirely, and the matcher prefers `date ?? timestamp`,
# so emitting it changes date-distance scoring and therefore which rows
# auto-match. Flip this if a re-match produces unexpected results.
# TRANSACTIONS_EMIT_DATE=false
